#!/bin/sh
set -eu

project_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
public_content="$project_root/generated/content"

if [ ! -d "$public_content" ]; then
  printf '%s\n' 'error: reviewed public content is missing at generated/content' >&2
  exit 1
fi

cd "$project_root"
"$project_root/scripts/check-site"

printf '%s\n' \
  'Publication candidate validated and built.' \
  'Review the changes under generated/content, then commit and push them explicitly.'
